{
	"name": "jira-quick-info",
	"displayName": "JIRA Quick Info",
	"description": "Get JIRA's summary, status and owner in the status bar",
	"version": "0.2.0",
	"icon": "logo.png",
	"publisher": "pierre-payen",
	"author": {
		"email": "payen.pierre@gmail.com",
		"name": "Pierre Payen",
		"url": "https://github.com/pirpyn"
	},
	"repository": "https://github.com/pirpyn/jira-quick-info",
	"license": "AGPL-3.0-only",
	"engines": {
		"vscode": "^1.91.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"keywords": [
		"jira"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "jira-quick-info.changeIssue",
				"title": "Jira Quick Info: change issue"
			},
			{
				"command": "jira-quick-info.removeThumbnails",
				"title": "Jira Quick Info: removes all thumbnails downloaded for the tooltip"
			},
			{
				"command": "jira-quick-info.openIssueInBrowser",
				"title": "Jira Quick Info: Open current selected issue in your browser"
			},
			{
				"command": "jira-quick-info.setPaths",
				"title": "Jira Quick Info: Set paths where the extension should be active"
			}
		],
		"configuration": {
			"title": "jira-quick-info",
			"properties": {
				"jira-quick-info.issue": {
					"type": "string",
					"scope": "resource",
					"default": "",
					"description": "the JIRA issue to show"
				},
				"jira-quick-info.url": {
					"type": "string",
					"scope": "machine",
					"default": "https://change.me/jira",
					"description": "the base URL where your instance of JIRA is"
				},
				"jira-quick-info.tokenPath": {
					"type": "string",
					"scope": "machine",
					"default": "/path/to/token",
					"description": "a path to a file containing a personnal access token (PAT) to authenticate"
				},
				"jira-quick-info.accountEmail": {
					"type": "string",
					"scope": "machine",
					"default": "atlassian_account@provider.com",
					"description": "the Atlassian account email used with the API token"
				},
				"jira-quick-info.paths": {
					"type": "array",
					"scope": "machine-overridable",
					"default": ["/home", "/workspace" ],
					"description": "An array on path in wich the extension should be active. If the current opened file is in one of those paths, the extension will be active and show the JIRA info in the status bar"
				}
			}
		}
	},
	"extensionKind": [
		"ui",
		"workspace"
	],
	"scripts": {
		"compile": "npm run check-types && node esbuild.js",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && node esbuild.js --production"
	},
	"dependencies": {
		"axios": "^1.19.0",
		"jira2md": "^3.0.1"
	},
	"devDependencies": {
		"@types/node": "^26.5.0",
		"@types/vscode": "~1.136.0",
		"esbuild": "^0.28.2",
		"npm-run-all": "^4.1.5",
		"typescript": "^7.0.2"
	}
}
