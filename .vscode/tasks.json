// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"options": {
				// login shell needed so fnm (~/.bash_profile) puts node/npm on PATH
				"shell": {
					"executable": "/bin/bash",
					"args": ["-l", "-c"]
				}
			}
		}
	]
}
